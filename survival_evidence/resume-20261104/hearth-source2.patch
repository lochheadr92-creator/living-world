diff --git a/scripts/browser/hearth_check.mjs b/scripts/browser/hearth_check.mjs
new file mode 100644
index 0000000..1e1dbe7
--- /dev/null
+++ b/scripts/browser/hearth_check.mjs
@@ -0,0 +1,42 @@
+import {existsSync,mkdirSync,writeFileSync} from 'node:fs';
+import {resolve,join,sep} from 'node:path';
+import {tmpdir} from 'node:os';
+import {randomUUID} from 'node:crypto';
+import {launch} from './cdp.mjs';
+const [url='http://127.0.0.1:5296/',out='survival_evidence/hearth-rendered']=process.argv.slice(2);
+if(existsSync(out))throw Error('Fresh output required');
+mkdirSync(out,{recursive:true});
+const root=resolve(tmpdir()),profile=resolve(root,'living-world-hearth-'+randomUUID());
+if(!profile.startsWith(root+sep)||existsSync(profile))throw Error('Unsafe profile');
+const browser=await launch({port:9376,width:1440,height:1000,profile});
+const checks=[],check=(name,ok,detail)=>{checks.push({name,ok:!!ok,detail});console.log(`${ok?'PASS':'FAIL'} ${name}`);};
+const shot=async name=>{await browser.evaluate('window.__ui.update(1)');await browser.sleep(200);await browser.shot(join(out,name+'.png'));return browser.evaluate("document.querySelector('.insp-entity')?.textContent||''");};
+try{
+  await browser.send('Page.navigate',{url});
+  for(let n=0;n<100&&!await browser.evaluate('!!window.__game');n++)await browser.sleep(100);
+  await browser.evaluate(`(async()=>{
+    const {hearthScene}=await import('/tests/helpers/hearth.ts');
+    const activity=await import('/src/sim/activities.ts'),hearth=await import('/src/sim/hearth.ts');
+    const save=await import('/src/app/save.ts'),decision=await import('/src/sim/decision.ts'),econ=await import('/src/sim/economy.ts');
+    const f=hearthScene();Object.assign(f,{activity,hearth,save,decision,econ});window.__hearth=f;
+    const g=window.__game;g.setPlaying(false);g.restoreWorld(f.w,f.w.settings);g.select(f.b.id);
+    const {project}=await import('/src/render/iso.ts');const pt=project(41,41);g.fly=null;g.camera={x:pt.sx+120,y:pt.sy,zoom:2};
+    const o=decision.generateOptions(f.w,f.p,true,true).options.find(o=>o.key==='hearth_fuel:'+f.b.id);
+    if(!o)throw Error('No offered hearth action');activity.startActivity(f.w,f.p,o.make());
+    for(let n=0;n<300&&f.p.activity;n++){f.w.tick++;activity.stepActivity(f.w,f.p);}
+    for(let n=0;n<100;n++){f.w.tick++;hearth.hearthTick(f.w,f.b);}
+    f.saved=save.serializeWorld(f.w);
+  })()`);
+  const warm=await shot('occupied-heated-home');
+  check('fuel and actual occupant shown',warm.includes('burning')&&warm.includes('Ada')&&warm.includes('occupants only'),warm);
+  check('render is pure',await browser.evaluate('window.__hearth.saved===window.__hearth.save.serializeWorld(window.__hearth.w)'));
+  const paid=await browser.evaluate('({paid:window.__hearth.w.ledger.consumed.wood,inside:window.__hearth.p.indoors===window.__hearth.b.id,conserved:window.__hearth.econ.conservationReport(window.__hearth.w).ok})');
+  check('paid fuel delivered inside',paid.paid===2&&paid.inside&&paid.conserved,paid);
+  await browser.evaluate(`(()=>{const f=window.__hearth;while(f.b.hearth.fuel>0){f.w.tick++;f.hearth.hearthTick(f.w,f.b);}f.saved=f.save.serializeWorld(f.w);})()`);
+  const cooling=await shot('fuel-exhausted-cooling');
+  check('real exhausted-fuel state retains finite cooling heat',cooling.includes('fuel exhausted; residual heat is cooling')&&cooling.includes('0 ticks of paid fuel'),cooling);
+  check('exhausted state save round-trips exactly',await browser.evaluate('window.__hearth.saved===window.__hearth.save.serializeWorld(window.__hearth.save.deserializeWorld(window.__hearth.saved))'));
+  check('no browser exceptions',!browser.events.some(e=>e.method==='Runtime.exceptionThrown'));
+  writeFileSync(join(out,'report.json'),JSON.stringify({evidence:'STAGED home and fitting; ordinary offered fuel action, paid fuel and physical cooling.',checks},null,2));
+  if(checks.some(c=>!c.ok))process.exitCode=1;
+}finally{await browser.close();}
diff --git a/scripts/browser/hearth_manual.html b/scripts/browser/hearth_manual.html
new file mode 100644
index 0000000..827e763
--- /dev/null
+++ b/scripts/browser/hearth_manual.html
@@ -0,0 +1,29 @@
+<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Staged hearth verification</title></head><body>
+<div id="app"><canvas id="world" aria-label="The simulated world"></canvas><div id="ui"></div></div>
+<div style="position:fixed;top:70px;left:10px;width:200px;z-index:2000;background:#15251c;padding:10px;color:white"><strong>STAGED hearth contract</strong> <button id="fuel">Run offered fuel work</button> <button id="cool">Run until fuel exhausted</button><output id="result"></output></div>
+<script type="module">
+import '/src/styles.css';
+import {Game} from '/src/app/game.ts';
+import {Renderer} from '/src/render/renderer.ts';
+import {mountUI} from '/src/ui/index.ts';
+import {project} from '/src/render/iso.ts';
+import {hearthScene} from '/tests/helpers/hearth.ts';
+import {generateOptions} from '/src/sim/decision.ts';
+import {startActivity,stepActivity} from '/src/sim/activities.ts';
+import {hearthTick} from '/src/sim/hearth.ts';
+import {serializeWorld,deserializeWorld} from '/src/app/save.ts';
+import {conservationReport} from '/src/sim/economy.ts';
+const {w,p,b}=hearthScene(),g=new Game(w.settings);g.restoreWorld(w,w.settings);g.setPlaying(false);g.select(b.id);
+const pt=project(41,41);g.camera={x:pt.sx+120,y:pt.sy,zoom:2};
+const renderer=new Renderer(document.getElementById('world'),g),ui=mountUI(g,document.getElementById('ui'));
+const result=document.getElementById('result');
+function verify(){const before=serializeWorld(w);ui.update(1);const pure=before===serializeWorld(w);const exact=before===serializeWorld(deserializeWorld(before));result.textContent=` Paid wood: ${w.ledger.consumed.wood??0}; indoors: ${p.indoors===b.id}; conservation: ${conservationReport(w).ok}; pure: ${pure}; exact save: ${exact}`;}
+document.getElementById('fuel').onclick=()=>{
+ const o=generateOptions(w,p,true,true).options.find(o=>o.key==='hearth_fuel:'+b.id);
+ if(!o){result.textContent='No fuel activity is currently offered';return;}
+ startActivity(w,p,o.make());for(let n=0;n<300&&p.activity;n++){w.tick++;stepActivity(w,p);}
+ for(let n=0;n<100;n++){w.tick++;hearthTick(w,b);}verify();
+};
+document.getElementById('cool').onclick=()=>{while(b.hearth.fuel>0){w.tick++;hearthTick(w,b);}verify();};
+function frame(){renderer.frame(0.016);ui.update(0.016);requestAnimationFrame(frame);}frame();verify();
+</script></body></html>
